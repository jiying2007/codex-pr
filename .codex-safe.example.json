{
  "$schema": "https://raw.githubusercontent.com/jiying2007/codex-safe-core/a9b6906c7d93bcc521c1a78f5168074972aa25a2/codex-safe.schema.json",
  "schemaVersion": 4,
  "review": {
    "language": "en",
    "maxDiffBytes": 524288,
    "maxFindings": 40,
    "severityThreshold": "low",
    "confidenceThreshold": 0.7,
    "timeoutSeconds": 120
  },
  "commit": {
    "language": "en",
    "maxDiffBytes": 262144,
    "subjectMaxLength": 72,
    "maxBodyChars": 2000,
    "timeoutSeconds": 90
  },
  "change": {
    "provenancePolicy": "require-all",
    "blockOnReviewFindings": true,
    "requireCleanWorktree": true,
    "requirePushedHead": true,
    "requireFreshTarget": true,
    "requiredChecks": [
      "build",
      "unit-test"
    ],
    "requiredApprovals": 1,
    "titlePolicy": "create-only",
    "managedSections": true
  }
}
