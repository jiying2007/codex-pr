{
  "name": "codex-change-safe",
  "displayName": "Codex Change Safe",
  "description": "GitHub Pull Request and GitLab Merge Request delivery authorization with committed policy, provenance, provider-native merge gates and zero default model calls.",
  "version": "5.4.0",
  "publisher": "jiying2007",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "pull request",
    "merge request",
    "github",
    "gitlab",
    "delivery",
    "codex",
    "scm",
    "safe"
  ],
  "activationEvents": [
    "onCommand:safeCodexChange.preflight",
    "onCommand:safeCodexChange.createOrUpdate",
    "onCommand:safeCodexChange.refresh",
    "onCommand:safeCodexChange.requestReviewers",
    "onCommand:safeCodexChange.markReady",
    "onCommand:safeCodexChange.enableAutoMerge",
    "onCommand:safeCodexChange.enqueueMergeQueue",
    "onCommand:safeCodexChange.enqueueMergeTrain",
    "onCommand:safeCodexChange.doctor",
    "onCommand:safeCodexChange.open",
    "onView:safeCodexChange.delivery"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "safeCodexChange.preflight",
        "title": "Codex Change Safe: Delivery Preflight",
        "category": "Codex Change Safe",
        "icon": "$(pass)"
      },
      {
        "command": "safeCodexChange.createOrUpdate",
        "title": "Codex Change Safe: Create / Update PR or MR",
        "category": "Codex Change Safe",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "safeCodexChange.refresh",
        "title": "Codex Change Safe: Refresh Merge Readiness",
        "category": "Codex Change Safe",
        "icon": "$(refresh)"
      },
      {
        "command": "safeCodexChange.requestReviewers",
        "title": "Codex Change Safe: Request Suggested Reviewers",
        "category": "Codex Change Safe"
      },
      {
        "command": "safeCodexChange.markReady",
        "title": "Codex Change Safe: Mark Ready for Review",
        "category": "Codex Change Safe"
      },
      {
        "command": "safeCodexChange.enableAutoMerge",
        "title": "Codex Change Safe: Enable Native Auto-Merge",
        "category": "Codex Change Safe"
      },
      {
        "command": "safeCodexChange.enqueueMergeQueue",
        "title": "Codex Change Safe: Enqueue GitHub Merge Queue",
        "category": "Codex Change Safe"
      },
      {
        "command": "safeCodexChange.open",
        "title": "Codex Change Safe: Open PR or MR",
        "category": "Codex Change Safe"
      },
      {
        "command": "safeCodexChange.enqueueMergeTrain",
        "title": "Codex Change Safe: Enqueue GitLab Merge Train",
        "category": "Codex Change Safe"
      },
      {
        "command": "safeCodexChange.doctor",
        "title": "Codex Change Safe: Check Environment / Doctor",
        "category": "Codex Change Safe",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "safeCodexChange.createOrUpdate",
          "when": "scmProvider == git && isWorkspaceTrusted",
          "group": "navigation@7"
        }
      ],
      "view/title": [
        {
          "command": "safeCodexChange.preflight",
          "when": "view == safeCodexChange.delivery",
          "group": "navigation@1"
        },
        {
          "command": "safeCodexChange.createOrUpdate",
          "when": "view == safeCodexChange.delivery",
          "group": "navigation@2"
        },
        {
          "command": "safeCodexChange.refresh",
          "when": "view == safeCodexChange.delivery",
          "group": "navigation@3"
        },
        {
          "command": "safeCodexChange.doctor",
          "when": "view == safeCodexChange.delivery",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Codex Change Safe",
      "properties": {
        "safeCodexChange.provider": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "gitlab"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "SCM provider. auto recognizes cloud hosts and performs a credential-free same-host probe for self-managed instances; SSH/custom hosts probe HTTPS first and, only after explicit allowInsecureHttp opt-in, private-LAN HTTP."
        },
        "safeCodexChange.targetBranch": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Target branch. Empty discovers the target repository default branch."
        },
        "safeCodexChange.githubApiBaseUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "scope": "resource",
          "description": "GitHub REST API base. GitHub.com uses api.github.com; GHES values must end with /api/v3 and may include a relative URL root."
        },
        "safeCodexChange.githubTokenEnv": {
          "type": "string",
          "default": "GITHUB_TOKEN",
          "scope": "machine",
          "description": "Environment variable containing the GitHub token. The token value is never stored in VS Code settings."
        },
        "safeCodexChange.gitlabApiBaseUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "GitLab API v4 base. Empty derives a same-host endpoint; explicit values must end with /api/v4 and support custom ports/relative URL roots."
        },
        "safeCodexChange.gitlabTokenEnv": {
          "type": "string",
          "default": "GITLAB_TOKEN",
          "scope": "machine",
          "description": "Environment variable containing the GitLab token. The token value is never stored in VS Code settings."
        },
        "safeCodexChange.allowInsecureHttp": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow plaintext HTTP only for explicitly trusted internal SCM. For private IP literals, SSH/custom-host discovery tries HTTP only after HTTPS. PAT/API payloads remain plaintext on the network; prefer HTTPS and NODE_EXTRA_CA_CERTS."
        },
        "safeCodexChange.requestTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 3,
          "maximum": 120,
          "scope": "application"
        },
        "safeCodexChange.requireCleanWorktree": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "safeCodexChange.requirePushedHead": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "safeCodexChange.requireFreshTarget": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "safeCodexChange.createAsDraft": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "safeCodexChange.requiredChecks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource"
        },
        "safeCodexChange.requiredApprovals": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 20,
          "scope": "resource"
        },
        "safeCodexChange.labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource"
        },
        "safeCodexChange.reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional reviewer usernames. CODEOWNERS-derived reviewers are added deterministically."
        },
        "safeCodexChange.managedSections": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "safeCodexChange.includeReceipt": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "safeCodexChange.provenancePolicy": {
          "type": "string",
          "enum": [
            "advisory",
            "require-review",
            "require-commit",
            "require-all"
          ],
          "default": "advisory",
          "scope": "resource",
          "description": "How Review Receipt v5 and Commit Receipt v4 coverage participates in Delivery Preflight."
        },
        "safeCodexChange.blockOnReviewFindings": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Block delivery when matching Codex Review Safe range evidence reports blocking findings."
        },
        "safeCodexChange.sourceRemote": {
          "type": "string",
          "default": "origin",
          "scope": "resource",
          "description": "Git remote containing the source branch."
        },
        "safeCodexChange.targetRemote": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Git remote containing the target repository. Empty uses sourceRemote."
        },
        "safeCodexChange.titlePolicy": {
          "type": "string",
          "enum": [
            "create-only",
            "preserve",
            "managed"
          ],
          "default": "create-only",
          "scope": "resource",
          "description": "PR/MR title ownership. create-only/preserve do not overwrite an existing human title; managed lets Change Safe update it."
        },
        "safeCodexChange.teamReviewerMap": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Optional mapping from CODEOWNERS team/group names to GitLab reviewer usernames."
        },
        "safeCodexChange.trustedApiHostAliases": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Explicit same-instance API hostname aliases for internal SCM, e.g. {\"gitlab.company.local\":[\"10.0.0.20\"]}. Use only when both names identify the same trusted server."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "safeCodexChange.delivery",
          "name": "Codex Change Safe",
          "when": "isWorkspaceTrusted"
        }
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test:unit": "node --test test/*.test.js",
    "test": "npm run test:unit",
    "ci": "npm run check && npm run verify:manifest && node src/codex-safe-core/scripts/verify-family-ui-contract.js . && npm run verify:actions && npm run test:unit",
    "verify:manifest": "node scripts/verify-manifest.js",
    "verify:actions": "node scripts/verify-actions-pins.js",
    "build": "node scripts/build.js",
    "package": "node scripts/package.js",
    "test:integration": "node test/integration/runTest.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jiying2007/codex-pr.git"
  },
  "homepage": "https://github.com/jiying2007/codex-pr#readme",
  "bugs": {
    "url": "https://github.com/jiying2007/codex-pr/issues"
  },
  "pricing": "Free",
  "preview": false
}
